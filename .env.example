# --------------------------------------------------------------------------
# stacSOL local-dev env template. Copy to `.env.local` and fill in your own
# values. Never commit `.env` or `.env.local` — both are gitignored.
# --------------------------------------------------------------------------

# Solana RPC endpoint. Use any provider that supports getAccountInfo,
# getSignaturesForAddress, and (for the dapp's WebSocket subscriptions) a
# working WSS endpoint. Triton One, Helius, QuickNode, and Solana's free
# `https://api.mainnet-beta.solana.com` all work for read-only flows;
# rate-limit-aware paid plans are recommended for production.
RPC_URL="https://mainnet.helius-rpc.com/?api-key=89a5704a-97ad-4c43-9be4-f04dc03a6b34"

# Same value, exposed to the Vite client bundle. Keep them in sync. Anything
# you put here is publicly visible to every visitor of the deployed site —
# do NOT use a key with write/staking authority for this.
VITE_RPC_URL="https://mainnet.helius-rpc.com/?api-key=89a5704a-97ad-4c43-9be4-f04dc03a6b34"

# Postgres (Neon / Supabase / any managed PG). Used by /api/leaderboard,
# /api/history, /api/snapshot, /api/referral-index. Optional — those routes
# 500 cleanly without it; the rest of the app works fine.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Birdeye API key. Used by /api/snapshot and /api/lp for token-pair stats.
# Free-tier key works. Get one at https://birdeye.so/
BIRDEYE_API_KEY=""

# Jupiter API key. Used by /api/jup-quote and /api/jup-swap to fetch swap
# quotes for the LP zap-in flows. Free-tier key works. Get one at
# https://developers.jup.ag/portal
JUPITER_API_KEY=""

# --------------------------------------------------------------------------
# Fork addresses (set after running scripts/fork-launch.ts). The client reads
# VITE_MINT / VITE_POOL; the operational scripts read MINT / POOL. Until set,
# the code falls back to the original stacSOL deployment.
# --------------------------------------------------------------------------
VITE_MINT=""
VITE_POOL=""
MINT=""
POOL=""

# --------------------------------------------------------------------------
# Fork fee split (scripts/burn-loop.ts).
#   LIQD_DESTINATION — the PDA that receives the SOL half. Leave empty to burn
#                      100% (original behavior). REQUIRED to run the split.
#   SPLIT_LIQD_BPS   — fraction redeemed-to-SOL → PDA; rest is burned.
#                      5000 = 50/50 (6.9% liqd + 6.9% burn of the 13.8% fee).
# --------------------------------------------------------------------------
LIQD_DESTINATION=""
SPLIT_LIQD_BPS="5000"

# --------------------------------------------------------------------------
# Launch / manager keypair (scripts/fork-launch.ts + scripts/burn-loop.ts).
# Provide ONE of these at runtime. NEVER commit a key; use a FRESH one — any
# key pasted into a chat/log is compromised. Both forms are gitignored.
#   KEYPAIR      — path to a Solana CLI keypair JSON
#   KEYPAIR_JSON — the raw JSON byte array (handy for Railway/Vercel secrets)
# --------------------------------------------------------------------------
KEYPAIR="./launch.json"
KEYPAIR_JSON=""
